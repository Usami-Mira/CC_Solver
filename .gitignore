# 题目输出和中间结果（除样例题目外）
problems/*/
!problems/example_single/
!problems/example_multiple/
pipeline_v3/
*.metrics
*.result
final_summary.md

# 输入目录（题目 PDF 和解答）
input/

# 临时任务文件
*_task*
*.tmp

# === API keys 和敏感信息 ===
.env
.env.*
*.key
*credentials*
*secret*
# secretary 是 Agent 角色文件，不是敏感信息
!prompts/agents/secretary.md

# === textbook/ 中间文件不提交（只提交辅助脚本与最终成果；
#     RAG 数据以 remote 为准，本地运行期变动不覆盖、不入库） ===

# 原始 PDF
textbook/*.pdf

# OCR 输出（MinerU 等，所有 *_output 目录）
textbook/*_output/

# 合并/分块/翻译/分章的中间产物
textbook/merged/
textbook/merged_new/
textbook/by_chapter/

# 图片上下文数据
textbook/image_context.json

# 教材处理流水线的状态文件
textbook/.state

# 嵌入模型（bge-m3，~2.3GB，由 setup.sh 自动下载）
textbook/models/

# Python 虚拟环境（~5GB）
textbook/rag_env/
textbook/venv/

# Weaviate 本地数据（向量库，运行期会被改写）
textbook/weaviate_data/
textbook/.local/

# Python 缓存
__pycache__/
*.pyc

# 杂项
*:Zone.Identifier
*.log
