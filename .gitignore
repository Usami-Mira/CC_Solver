# 题目输出和中间结果（除样例题目外）
problems/*/
!problems/example_single/
!problems/example_multiple/
pipeline_v3/
*.metrics
*.result
final_summary.md

# 输入目录（题目 PDF 和解答）
input/

# 临时任务文件
*_task*
*.tmp

# === API keys 和敏感信息 ===
.env
.env.*
*.key
*credentials*
*secret*
# secretary 是 Agent 角色文件，不是敏感信息
!prompts/agents/secretary.md

# === textbook/ 内的数据文件（不跟踪） ===

# 原始 PDF
textbook/*.pdf

# OCR 输出（MinerU）
textbook/em_output/
textbook/mec_output/
textbook/opt_output/
textbook/thrm_output/
textbook/fix_output/

# 合并后的 Markdown 和图片
textbook/merged/*.md
textbook/merged/images/
textbook/merged/chunks.json
textbook/merged/chunks_translated.json
textbook/merged/translation_cache/

# 章节总结与习题答案（个人文件，不提交）
textbook/merged/by_chapter/*/summary.md
textbook/merged/by_chapter/*/ans_c*.md

# 提取的教材内容（含原文，不提交）
textbook/merged/examples.json
textbook/merged/exercises.json
textbook/merged/pure_content.json
textbook/merged/chunked_examples.json
textbook/merged/chunked_pure_content.json
textbook/merged/chunks_final.json

# 图片上下文数据
textbook/image_context.json

# 嵌入模型（bge-m3，~2.3GB，由 setup.sh 自动下载）
textbook/models/

# Python 虚拟环境（~5GB）
textbook/rag_env/
textbook/venv/

# Weaviate 本地数据
textbook/.local/

# Python 缓存
__pycache__/
*.pyc

# 杂项
*:Zone.Identifier
*.log
