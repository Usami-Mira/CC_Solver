{
  "pipeline": "adaptive",
  "max_concurrent_problems": 3,
  "max_disputes": 2,
  "memory_guard": "quarantine",

  "configs": {
    "standard": {
      "model": "qwen3.6-plus",
      "timeout_seconds": 3600,
      "max_revisions": 8,
      "agent_models": {
        "Planner": "qwen3.6-plus",
        "Builder": "qwen3.6-plus",
        "Evaluator": "qwen3.6-plus"
      }
    },

    "parallel": {
      "model": "qwen3.6-plus",
      "timeout_seconds": 3600,
      "num_planners": 3,
      "max_revisions": 8,
      "agent_models": {
        "Planner": "qwen3.6-plus",
        "Meta-Planner": "qwen3.6-plus",
        "Builder": "qwen3.6-plus",
        "Evaluator": "qwen3.6-plus"
      }
    },

    "iterative": {
      "model": "qwen3.6-plus",
      "timeout_seconds": 3600,
      "max_iterations": 12,
      "max_revisions": 8,
      "agent_models": {
        "Explorer": "qwen3.6-plus",
        "Builder": "qwen3.6-plus",
        "Evaluator": "qwen3.6-plus"
      }
    },

    "debate": {
      "model": "qwen3.6-plus",
      "timeout_seconds": 3600,
      "max_rounds": 5,
      "max_revisions": 8,
      "agent_models": {
        "Theorist": "qwen3.6-plus",
        "Computationalist": "qwen3.6-plus",
        "Experimentalist": "qwen3.6-plus",
        "Critic": "qwen3.6-plus",
        "Secretary": "qwen3.6-plus",
        "Builder": "qwen3.6-plus",
        "Evaluator": "qwen3.6-plus"
      }
    },

    "tree_search": {
      "model": "qwen3.6-plus",
      "timeout_seconds": 3600,
      "max_iterations": 20,
      "max_revisions": 8,
      "ephemeral_timeout": 600,
      "agent_models": {
        "Planner": "qwen3.6-plus",
        "Verifier": "qwen3.6-plus",
        "Builder": "qwen3.6-plus",
        "Evaluator": "qwen3.6-plus"
      }
    },

    "adaptive": {
      "model": "qwen3.6-plus",
      "timeout_seconds": 86400,
      "max_iterations": 25,
      "max_revisions": 8,
      "calculation_timeout": 600,
      "agent_models": {
        "Planner": "qwen3.6-plus",
        "Verifier": "qwen3.6-plus",
        "Builder": "qwen3.6-plus",
        "Evaluator": "qwen3.6-plus"
      }
    },

    "deep_search": {
      "model": "qwen3.6-plus",
      "timeout_seconds": 864000,
      "max_iterations": 20,
      "max_revisions": 8,
      "max_motions": 6,
      "max_verify_rounds": 3,
      "max_subtasks": 3,
      "ephemeral_timeout": 6000,
      "deep_timeout": 18000,
      "agent_models": {
        "Planner": "qwen3.6-plus",
        "Theorist": "qwen3.6-plus",
        "Computationalist": "qwen3.6-plus",
        "Experimentalist": "qwen3.6-plus",
        "Critic": "qwen3.6-plus",
        "Secretary": "qwen3.6-plus",
        "Verifier": "qwen3.6-plus",
        "Builder": "qwen3.6-plus",
        "Evaluator": "qwen3.6-plus"
      }
    }
